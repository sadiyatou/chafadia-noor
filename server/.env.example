DATABASE_URL=postgresql://postgres:chafadia2026@localhost:5432/chafadia_noor
JWT_SECRET=your-secret-key-change-this-in-production
PORT=5000
UPLOADS_DIR=./uploads

# Islamic AI agent (server/routes/ai.js). Get a key at https://console.anthropic.com
# The endpoint degrades gracefully if this is unset — the app falls back to
# its built-in answer bank instead of erroring.
ANTHROPIC_API_KEY=

# Optional TURN server for WebRTC calls behind strict NATs/carrier networks
# (public STUN alone is used if these are unset — works on many but not all
# networks). Format for TURN_URLS: comma-separated turn: URIs.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Push notifications (expo-server-sdk) for messages/calls when app is backgrounded.
# No key needed — Expo's push service is used with each user's stored push token.
