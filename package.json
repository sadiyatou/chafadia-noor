{
  "name": "chafadia-noor",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "description": "Chafadia Noor - All-In-One Muslim Guide App",
  "author": "Chafadia Noor",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "dev": "expo start --dev-client",
    "clean": "expo start -c",
    "reset-project": "node ./scripts/reset-project.js"
