  "devDependencies": {
    "@babel/core": "^7.28.3",
    "@types/react": "~19.1.0",
    "@types/react-native": "^0.73.0",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~10.0.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "typescript": "~5.9.2"
  },
  "expo": {
    "name": "Chafadia Noor",
    "slug": "chafadia-noor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "chafadianoor",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#063B28"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chafadianoor.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#063B28"
      },
      "package": "com.chafadianoor.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "INTERNET"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-notifications",
      "expo-location",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
